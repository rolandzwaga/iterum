// Channel capabilities describe ONLY the main output bus (element 0 in
// AU vocabulary). Seraphis exposes a single stereo output bus and no audio
// input bus (no sidechain), so exactly one config is declared here.
//
// Format: each character is one digit, and digits are consumed in pairs as
// (inputs, outputs) configs.
// "02" = one config: 0 in, 2 out (stereo instrument, no sidechain).
// "0022" would NOT mean "0 in / 2 out" - it parses as (0,0)+(2,2), which
// declares a stereo audio input the processor does not provide and makes AU
// host init fail with -10875.
#define kSupportedNumChannels     02

