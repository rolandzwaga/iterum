<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <!-- Seraphis Phase 11 - the organism-first editor (specs/seraphis-phase11-ui,
       plan section 9, tasks T019). FIXED 1000 x 700 (RQ-3): no zoom factors, no
       onSize relayout. The Phase 8 placeholder template and its banner are gone.

       THE BINDING BUDGET IS EXACT (C-3, FR-003, SC-002): 110 bound views over
       107 registered parameters. The three second bindings are the header freeze
       cluster - AtmosFreeze (1008), AetherFreeze (1204), FxSpectralFreeze (1430)
       - and they are the COMPLETE duplicate allowlist. Every other registered ID
       is bound exactly once, and unreachableParams() must come back EMPTY with an
       EMPTY allowlist. Adding a binding here without moving SC-002's number is a
       test failure, and the number is not the thing to edit.

       CHILD ORDER IS Z-ORDER. CloudView is child 0 (FR-006) so every ring, the
       header and the drawer draw OVER it.

       ONE SUB-CONTROLLER, ON THE TEMPLATE ROOT (D-4). That is what makes
       getViewSize() on the cloud view and on the drawer read in the window's own
       coordinate space (FR-023 / FR-024), and it is what puts the header preset
       button inside the sub-controller's sub-tree (FR-045). Tagged controls are
       unaffected: DelegationController forwards everything it does not claim.

       The session-tag attribute is a CUSTOM one the view factory ignores and
       SeraphisEditSubController::verifyView turns into setTag() + setListener().
       It is NEVER a control-tag, so it can never be counted as a binding. -->
  <colors>
    <color name="bg"       rgba="#1A1A2Eff"/>
    <color name="panel"    rgba="#202038ff"/>
    <color name="text"     rgba="#E0E0F0ff"/>
    <color name="text-dim" rgba="#9C9CBEff"/>
    <color name="track"    rgba="#242438ff"/>
    <color name="accent"   rgba="#8FA8D8ff"/>
  </colors>
  <fonts>
    <font name="title-font" font-name="Arial" size="16" bold="true"/>
    <font name="label-font" font-name="Arial" size="11"/>
    <font name="small-font" font-name="Arial" size="9"/>
  </fonts>
  <!-- FR-100 / SC-015: one <control-tag> per REGISTERED parameter, all 107 of
       them, named after the plugin_ids.h enumerator without the k / Id affixes.
       CARRIED OVER VERBATIM from Phase 8/9/10 (FR-002): no tag is added, removed,
       renamed or re-numbered by Phase 11 - the phase adds views, not tags. -->
  <control-tags>
    <!-- Global (0-99) -->
    <control-tag name="MasterGain"    tag="0"/>
    <control-tag name="Polyphony"     tag="1"/>
    <control-tag name="SoftLimit"     tag="2"/>
    <control-tag name="Seed"          tag="3"/>
    <!-- Macros (100-199) -->
    <control-tag name="MacroDream"    tag="100"/>
    <control-tag name="MacroBloom"    tag="101"/>
    <control-tag name="MacroDissolve" tag="102"/>
    <control-tag name="MacroGravity"  tag="103"/>
    <control-tag name="MacroEntropy"  tag="104"/>
    <!-- Harmonic Cloud (200-399) -->
    <control-tag name="CloudRichness"        tag="200"/>
    <control-tag name="CloudInharmonicity"   tag="201"/>
    <control-tag name="CloudTilt"            tag="202"/>
    <control-tag name="CloudMutation"        tag="203"/>
    <control-tag name="CloudGravity"         tag="204"/>
    <control-tag name="CloudDriftDepth"      tag="205"/>
    <control-tag name="CloudDriftSmoothness" tag="206"/>
    <control-tag name="CloudStereoSpread"    tag="207"/>
    <control-tag name="CloudAttack"          tag="208"/>
    <control-tag name="CloudDecay"           tag="209"/>
    <control-tag name="CloudEnvOffsetSpread" tag="210"/>
    <!-- Spectral Morph / Entropy (400-599) -->
    <control-tag name="MorphEntropy"          tag="400"/>
    <control-tag name="MorphBloom"            tag="401"/>
    <control-tag name="MorphPosition"         tag="402"/>
    <control-tag name="MorphTravelMode"       tag="403"/>
    <control-tag name="MorphTravelRate"       tag="404"/>
    <control-tag name="MorphSync"             tag="405"/>
    <control-tag name="MorphSyncNote"         tag="406"/>
    <control-tag name="MorphWaypointInterval" tag="407"/>
    <control-tag name="MorphStateCount"       tag="408"/>
    <control-tag name="MorphState0"           tag="409"/>
    <control-tag name="MorphState1"           tag="410"/>
    <control-tag name="MorphState2"           tag="411"/>
    <control-tag name="MorphState3"           tag="412"/>
    <!-- Life Modulators (600-699) -->
    <control-tag name="LifeSpatialDepth"    tag="600"/>
    <control-tag name="LifeSpatialRate"     tag="601"/>
    <control-tag name="LifeSpatialCoupling" tag="602"/>
    <control-tag name="LifeSpatialGrowth"   tag="603"/>
    <control-tag name="LifeVoiceWidth"      tag="604"/>
    <!-- Voice Envelope (700-799) -->
    <control-tag name="EnvMode"           tag="700"/>
    <control-tag name="EnvGrowthDuration" tag="701"/>
    <control-tag name="EnvStage0Ms"       tag="702"/>
    <control-tag name="EnvStage1Ms"       tag="703"/>
    <control-tag name="EnvReleaseMs"      tag="704"/>
    <!-- Continuous Body (800-999) -->
    <control-tag name="BodyMaterial"        tag="800"/>
    <control-tag name="BodyResonance"       tag="801"/>
    <control-tag name="BodyDamping"         tag="802"/>
    <control-tag name="BodyKeyTracking"     tag="803"/>
    <control-tag name="BodyDrive"           tag="804"/>
    <control-tag name="BodyMix"             tag="805"/>
    <control-tag name="BodyCloudMix"        tag="806"/>
    <control-tag name="BodyCloudDecay"      tag="807"/>
    <control-tag name="BodyCloudSize"       tag="808"/>
    <control-tag name="BodyCloudDamping"    tag="809"/>
    <control-tag name="BodyWidth"           tag="810"/>
    <control-tag name="BodyInputAgc"        tag="811"/>
    <control-tag name="BodyResonatorBypass" tag="812"/>
    <!-- Granular Atmosphere (1000-1199) -->
    <control-tag name="AtmosLevel"           tag="1000"/>
    <control-tag name="AtmosBlur"            tag="1001"/>
    <control-tag name="AtmosDensity"         tag="1002"/>
    <control-tag name="AtmosGrainSeconds"    tag="1003"/>
    <control-tag name="AtmosDriftDepth"      tag="1004"/>
    <control-tag name="AtmosPanSpread"       tag="1005"/>
    <control-tag name="AtmosDecorrelation"   tag="1006"/>
    <control-tag name="AtmosFreezeMix"       tag="1007"/>
    <control-tag name="AtmosFreeze"          tag="1008"/>
    <control-tag name="AtmosDriftSmoothness" tag="1009"/>
    <control-tag name="AtmosDriftRange"      tag="1010"/>
    <control-tag name="AtmosJitter"          tag="1011"/>
    <control-tag name="AtmosPosition"        tag="1012"/>
    <control-tag name="AtmosPositionSpread"  tag="1013"/>
    <control-tag name="AtmosPitch"           tag="1014"/>
    <control-tag name="AtmosPitchSpread"     tag="1015"/>
    <control-tag name="AtmosGrainEnvelope"   tag="1016"/>
    <!-- Aether Space (1200-1399) -->
    <control-tag name="AetherMix"               tag="1200"/>
    <control-tag name="AetherSize"              tag="1201"/>
    <control-tag name="AetherDensity"           tag="1202"/>
    <control-tag name="AetherDecay"             tag="1203"/>
    <control-tag name="AetherFreeze"            tag="1204"/>
    <control-tag name="AetherDimensionality"    tag="1205"/>
    <control-tag name="AetherDamping"           tag="1206"/>
    <control-tag name="AetherPreDelay"          tag="1207"/>
    <control-tag name="AetherModDepth"          tag="1208"/>
    <control-tag name="AetherModSmoothness"     tag="1209"/>
    <control-tag name="AetherShimmerOctave"     tag="1210"/>
    <control-tag name="AetherShimmerFifth"      tag="1211"/>
    <control-tag name="AetherBloomSend"         tag="1212"/>
    <control-tag name="AetherBloomDecay"        tag="1213"/>
    <control-tag name="AetherSpectralDiffusion" tag="1214"/>
    <control-tag name="AetherSizeBreathDepth"   tag="1215"/>
    <control-tag name="AetherTideDepth"         tag="1216"/>
    <control-tag name="AetherWidth"             tag="1217"/>
    <!-- Effects (1400+) -->
    <control-tag name="FxSaturation"      tag="1400"/>
    <control-tag name="FxDelayMix"        tag="1410"/>
    <control-tag name="FxDelayTime"       tag="1411"/>
    <control-tag name="FxDelaySpread"     tag="1412"/>
    <control-tag name="FxDelaySpreadDir"  tag="1413"/>
    <control-tag name="FxDelayFeedback"   tag="1414"/>
    <control-tag name="FxDelayTilt"       tag="1415"/>
    <control-tag name="FxDelayDiffusion"  tag="1416"/>
    <control-tag name="FxDelayWidth"      tag="1417"/>
    <control-tag name="FxDelaySync"       tag="1418"/>
    <control-tag name="FxDelaySyncNote"   tag="1419"/>
    <control-tag name="FxSpectralFreeze"  tag="1430"/>
    <control-tag name="FxStereoWidth"     tag="1440"/>
    <control-tag name="FxWanderDepth"     tag="1441"/>
    <control-tag name="FxWanderRate"      tag="1442"/>
    <control-tag name="FxAzimuthDepth"    tag="1443"/>
  </control-tags>

  <template name="editor" class="CViewContainer" size="1000, 700"
            background-color="bg" background-color-draw-style="filled"
            sub-controller="SeraphisEdit">

    <!-- ====================================================================
         1. THE CONSTELLATION - CHILD INDEX 0 (FR-006).
            Direct child of the root, so getViewSize() == (0, 32, 1000, 670),
            which is what FR-024 pins and what the drawer must never move.
         ==================================================================== -->
    <view class="CView" custom-view-name="CloudView" origin="0, 32" size="1000, 638"/>

    <!-- ====================================================================
         2. HEADER (0, 0, 1000, 32) - 7 bound views (FR-007).
            4 header-exclusive globals + the 3 SECOND bindings of the freeze
            cluster (RQ-2). The SERAPHIS wordmark and the preset button bind
            nothing and are not counted in the 110.
         ==================================================================== -->
    <view class="CTextLabel" title="SERAPHIS" origin="12, 6" size="112, 20"
          font="title-font" font-color="accent" transparent="true"
          text-alignment="left" mouse-enabled="false"/>

    <view class="CTextLabel" title="Gain" origin="130, 9" size="30, 14"
          font="small-font" font-color="text-dim" transparent="true"
          text-alignment="left" mouse-enabled="false"/>
    <view class="CSlider" control-tag="MasterGain" origin="162, 9" size="110, 14"
          orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true"
          frame-color="accent" back-color="track" value-color="accent"/>

    <view class="CTextLabel" title="Voices" origin="284, 9" size="40, 14"
          font="small-font" font-color="text-dim" transparent="true"
          text-alignment="left" mouse-enabled="false"/>
    <view class="COptionMenu" control-tag="Polyphony" origin="326, 7" size="56, 18"
          font="label-font" font-color="text" frame-color="accent" back-color="track"
          fill-color="track" frame-width="1" transparent="false"
          style-3D-in="false" style-3D-out="false"/>

    <view class="CCheckBox" control-tag="SoftLimit" origin="394, 7" size="70, 18"
          title="Limit" font="small-font" font-color="text"/>

    <view class="CTextLabel" title="Seed" origin="472, 9" size="32, 14"
          font="small-font" font-color="text-dim" transparent="true"
          text-alignment="left" mouse-enabled="false"/>
    <view class="COptionMenu" control-tag="Seed" origin="506, 7" size="56, 18"
          font="label-font" font-color="text" frame-color="accent" back-color="track"
          fill-color="track" frame-width="1" transparent="false"
          style-3D-in="false" style-3D-out="false"/>

    <!-- The freeze cluster: the ONLY three second bindings in the document. -->
    <view class="CCheckBox" control-tag="AtmosFreeze" origin="578, 7" size="88, 18"
          title="Atmos Frz" font="small-font" font-color="text"/>
    <view class="CCheckBox" control-tag="AetherFreeze" origin="670, 7" size="90, 18"
          title="Aether Frz" font="small-font" font-color="text"/>
    <view class="CCheckBox" control-tag="FxSpectralFreeze" origin="764, 7" size="88, 18"
          title="Spec Frz" font="small-font" font-color="text"/>

    <!-- Preset button: NO control-tag (FR-045 / D-5). A real CTextButton with
         kick-style="false": one valueChanged per click (a kick-style button
         fires twice and would self-cancel a toggle handler), and it draws its
         own frame + title, unlike the invisible bitmap-less COnOffButton this
         replaced (2026-08-04 dead-controls fix). -->
    <view class="CTextButton" session-tag="preset" title="PRESETS" kick-style="false"
          origin="898, 7" size="90, 18" font="label-font"/>

    <!-- ====================================================================
         3. THE FIVE MACRO RINGS, at C-1's anchors, over the constellation.
            MacroRingKnob is a registered ViewCreatorAdapter (C-7a), so it takes
            control-tag and the rest of the CControl attribute set.
         ==================================================================== -->
    <view class="MacroRingKnob" control-tag="MacroDream" origin="24, 56" size="96, 96"/>
    <view class="CTextLabel" title="DREAM" origin="24, 154" size="96, 14"
          font="label-font" font-color="text" transparent="true"
          text-alignment="center" mouse-enabled="false"/>

    <view class="MacroRingKnob" control-tag="MacroBloom" origin="880, 56" size="96, 96"/>
    <view class="CTextLabel" title="BLOOM" origin="880, 154" size="96, 14"
          font="label-font" font-color="text" transparent="true"
          text-alignment="center" mouse-enabled="false"/>

    <view class="MacroRingKnob" control-tag="MacroGravity" origin="24, 518" size="96, 96"/>
    <view class="CTextLabel" title="GRAVITY" origin="24, 616" size="96, 14"
          font="label-font" font-color="text" transparent="true"
          text-alignment="center" mouse-enabled="false"/>

    <view class="MacroRingKnob" control-tag="MacroDissolve" origin="880, 518" size="96, 96"/>
    <view class="CTextLabel" title="DISSOLVE" origin="880, 616" size="96, 14"
          font="label-font" font-color="text" transparent="true"
          text-alignment="center" mouse-enabled="false"/>

    <view class="MacroRingKnob" control-tag="MacroEntropy" origin="452, 556" size="96, 96"/>
    <view class="CTextLabel" title="ENTROPY" origin="452, 654" size="96, 14"
          font="label-font" font-color="text" transparent="true"
          text-alignment="center" mouse-enabled="false"/>

    <!-- ====================================================================
         4. EDIT MINI-TOOLBAR - tag-less, session-tagged, the sub-controller
            listens. None of these three is a parameter binding.
         ==================================================================== -->
    <view class="CTextButton" session-tag="mode" title="OBS | EDIT" kick-style="false"
          origin="140, 636" size="76, 22" font="small-font"/>

    <view class="CTextLabel" title="Blend A to B" origin="224, 622" size="100, 12"
          font="small-font" font-color="text-dim" transparent="true"
          text-alignment="left" mouse-enabled="false"/>
    <view class="CSlider" session-tag="blend" origin="224, 638" size="100, 16"
          orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true"
          frame-color="accent" back-color="track" value-color="accent"/>

    <view class="CTextLabel" title="Tilt dB/oct" origin="332, 622" size="100, 12"
          font="small-font" font-color="text-dim" transparent="true"
          text-alignment="left" mouse-enabled="false"/>
    <view class="CSlider" session-tag="tilt" origin="332, 638" size="100, 16"
          orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true"
          frame-color="accent" back-color="track" value-color="accent"/>

    <!-- ====================================================================
         5. THE DRAWER - a DIRECT CHILD OF THE ROOT (D-4), declared at its
            COLLAPSED rect (0, 670) .. (1000, 700). NEVER a
            UIViewSwitchContainer (R-10): all seven pages are present in the
            XML, exactly one visible, so every deep ParamID stays reachable.

            DrawerContainer::tabPage() picks out this container's child
            CViewContainers in document order, so the ONLY containers directly
            below are the seven pages. The handle and the seven tab buttons are
            CControls and are therefore never mistaken for a page.
         ==================================================================== -->
    <view class="CViewContainer" custom-view-name="DrawerContainer"
          origin="0, 670" size="1000, 30"
          background-color="panel" background-color-draw-style="filled">

      <view class="CTextButton" session-tag="drawerHandle" title="DEEP" kick-style="false"
            origin="8, 4" size="80, 22" font="label-font"/>

      <!-- FR-022's seven tabs, in EXACTLY this order. SC-004 arm 2 reads the
           titles back off the built tree in child order. -->
      <view class="CTextButton" session-tag="tab0" title="Cloud"
            origin="100, 4" size="96, 22" font="label-font"/>
      <view class="CTextButton" session-tag="tab1" title="Morph"
            origin="200, 4" size="96, 22" font="label-font"/>
      <view class="CTextButton" session-tag="tab2" title="Body"
            origin="300, 4" size="96, 22" font="label-font"/>
      <view class="CTextButton" session-tag="tab3" title="Atmos"
            origin="400, 4" size="96, 22" font="label-font"/>
      <view class="CTextButton" session-tag="tab4" title="Aether"
            origin="500, 4" size="96, 22" font="label-font"/>
      <view class="CTextButton" session-tag="tab5" title="FX"
            origin="600, 4" size="96, 22" font="label-font"/>
      <view class="CTextButton" session-tag="tab6" title="Life/Env"
            origin="700, 4" size="96, 22" font="label-font"/>

      <!-- ==================================================================
           PAGE 0 - Cloud (200-210, 11 bindings)
           ================================================================== -->
      <view class="CViewContainer" origin="0, 30" size="1000, 250" transparent="true">
        <view class="CTextLabel" title="Richness" origin="8, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudRichness" origin="30, 24" size="56, 56" arc-color="accent" guide-color="track"/>
        <view class="CTextLabel" title="Inharm" origin="118, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudInharmonicity" origin="140, 24" size="56, 56" arc-color="accent" guide-color="track"/>
        <view class="CTextLabel" title="Tilt" origin="228, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudTilt" origin="250, 24" size="56, 56" arc-color="accent" guide-color="track"/>
        <view class="CTextLabel" title="Mutation" origin="338, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudMutation" origin="360, 24" size="56, 56" arc-color="accent" guide-color="track"/>
        <view class="CTextLabel" title="Gravity" origin="448, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudGravity" origin="470, 24" size="56, 56" arc-color="accent" guide-color="track"/>
        <view class="CTextLabel" title="Drift" origin="558, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudDriftDepth" origin="580, 24" size="56, 56" arc-color="accent" guide-color="track"/>
        <view class="CTextLabel" title="Drift Smth" origin="668, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudDriftSmoothness" origin="690, 24" size="56, 56" arc-color="accent" guide-color="track"/>
        <view class="CTextLabel" title="Spread" origin="778, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudStereoSpread" origin="800, 24" size="56, 56" arc-color="accent" guide-color="track"/>
        <view class="CTextLabel" title="Attack" origin="888, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudAttack" origin="910, 24" size="56, 56" arc-color="accent" guide-color="track"/>

        <view class="CTextLabel" title="Decay" origin="8, 130" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudDecay" origin="30, 146" size="56, 56" arc-color="accent" guide-color="track"/>
        <view class="CTextLabel" title="Env Spread" origin="118, 130" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudEnvOffsetSpread" origin="140, 146" size="56, 56" arc-color="accent" guide-color="track"/>
      </view>

      <!-- ==================================================================
           PAGE 1 - Morph (400-412, 13 bindings; 409-412 ARE the four slot
           selectors of the budget table). The four session-tagged A..D buttons
           carry no control-tag and are not part of the 110.
           ================================================================== -->
      <view class="CViewContainer" origin="0, 30" size="1000, 250" transparent="true">
        <view class="CTextLabel" title="Entropy" origin="8, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MorphEntropy" origin="30, 24" size="56, 56" arc-color="accent" guide-color="track"/>
        <view class="CTextLabel" title="Bloom" origin="118, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MorphBloom" origin="140, 24" size="56, 56" arc-color="accent" guide-color="track"/>
        <view class="CTextLabel" title="Position" origin="228, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MorphPosition" origin="250, 24" size="56, 56" arc-color="accent" guide-color="track"/>
        <view class="CTextLabel" title="Travel" origin="338, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="COptionMenu" control-tag="MorphTravelMode" origin="343, 40" size="90, 20" font="label-font" font-color="text" frame-color="accent" back-color="track" fill-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false"/>
        <view class="CTextLabel" title="Rate" origin="448, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MorphTravelRate" origin="470, 24" size="56, 56" arc-color="accent" guide-color="track"/>
        <view class="CTextLabel" title="Sync" origin="558, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="CCheckBox" control-tag="MorphSync" origin="568, 40" size="80, 20" title="" font="small-font" font-color="text"/>
        <view class="CTextLabel" title="Sync Note" origin="668, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="COptionMenu" control-tag="MorphSyncNote" origin="673, 40" size="90, 20" font="label-font" font-color="text" frame-color="accent" back-color="track" fill-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false"/>
        <view class="CTextLabel" title="Waypoint" origin="778, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MorphWaypointInterval" origin="800, 24" size="56, 56" arc-color="accent" guide-color="track"/>
        <view class="CTextLabel" title="States" origin="888, 8" size="100, 12" font="small-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
